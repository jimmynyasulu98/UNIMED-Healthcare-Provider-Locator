<?xml version="1.0" encoding="UTF-8"?>
<!--
  osm2pgrouting import profile for ordinary motor-car candidates. Access and
  one-way tags are enforced in 01_finalize_network.sql; retaining tags is a
  required import option. Track is included because rural access roads around
  the two outlying providers may be tagged that way in OpenStreetMap.
-->
<configuration>
  <tag_name name="highway" id="1">
    <tag_value name="road"             id="100" priority="5.00" maxspeed="50" />
    <tag_value name="motorway"         id="101" priority="1.00" maxspeed="130" />
    <tag_value name="motorway_link"    id="102" priority="1.00" maxspeed="80" />
    <tag_value name="trunk"            id="103" priority="1.05" maxspeed="110" />
    <tag_value name="trunk_link"       id="104" priority="1.05" maxspeed="80" />
    <tag_value name="primary"          id="105" priority="1.15" maxspeed="90" />
    <tag_value name="primary_link"     id="106" priority="1.15" maxspeed="70" />
    <tag_value name="secondary"        id="107" priority="1.50" maxspeed="80" />
    <tag_value name="secondary_link"   id="108" priority="1.50" maxspeed="60" />
    <tag_value name="tertiary"         id="109" priority="1.75" maxspeed="70" />
    <tag_value name="tertiary_link"    id="110" priority="1.75" maxspeed="50" />
    <tag_value name="residential"      id="111" priority="2.50" maxspeed="50" />
    <tag_value name="living_street"    id="112" priority="3.00" maxspeed="20" />
    <tag_value name="service"          id="113" priority="2.50" maxspeed="30" />
    <tag_value name="unclassified"     id="114" priority="3.00" maxspeed="60" />
    <tag_value name="track"            id="115" priority="5.00" maxspeed="20" />
  </tag_name>
</configuration>
