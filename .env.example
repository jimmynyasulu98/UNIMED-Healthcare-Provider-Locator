# Copy this file to .env.local. These values are server-only; do not add a
# NEXT_PUBLIC_ prefix and do not use the PostgreSQL administrator account.
PGHOST=localhost
PGPORT=5432
PGDATABASE=unimed_provider_locator
PGUSER=unimed_locator_app
PGPASSWORD=replace_with_your_local_password

# Optional: uncomment all five variables after creating the separate routing
# test database described in database/routing/README.md. When omitted, the
# default straight-line search continues to work and road mode reports that
# routing is unavailable.
# ROUTING_PGHOST=localhost
# ROUTING_PGPORT=5432
# ROUTING_PGDATABASE=unimed_provider_locator_routing_test
# ROUTING_PGUSER=unimed_locator_routing_app
# ROUTING_PGPASSWORD=replace_with_your_local_routing_password
